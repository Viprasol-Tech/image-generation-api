# Image Generation API — example environment.
# Copy to `.env` and fill in only what you need. The default fake provider
# requires NONE of these and runs fully offline.

# Server bind
HOST=0.0.0.0
PORT=8000

# Optional: OpenAI Images provider
OPENAI_API_KEY=

# Optional: Stable Diffusion model id (diffusers)
SD_MODEL_ID=stabilityai/stable-diffusion-2-1
